z plus, et prenez contact dès maintenant avec notre équipe commerciale pour plus d'information.","addr":"9 Rue Françoise Sagan","gal":["https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6IjJmMjcwMjk2YmI3ZWIxMjAyYzBkYjRjZDIxOGEyZmZiN2U0OWNkZWYiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiJhYjcyNGIwMzkyMDdiNzk0OWU2ZDczZmJiMzI1M2Q0ZCJ9?signature=eaef4c4b60b00ae6b5720d885b71e94fbfd51b7d24c9388da2603c13fa9608ff","https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImRiMDM4MWQzMDY4YjJlOTRhYTIzMTJkZjEwNTQ0MjdmZjZlOWI0ZjUiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiI2Y2Y5NTYyNTkwZTRhOWUwM2Q3NjNmODYxNGU3YWRhYyJ9?signature=0ef23e26745dcc098a8f2a1b609eb4e902c6d27fa3e33ecfc27c803efcec55f8","https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImViOWU2MzdjYzUzNGRmOWI2YjcwMzdmMzgyOGY1M2U0MDY5ZDM4ODAiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiI0NmZjMmVkNjFiMzc1NTZjNTQyOTJkOTAxZjA3YTY0YSJ9?signature=23e22264b0b37f3cd59274adcbd673b81336881c36400bf146ba78e058b3cb9c"],"yt":[],"vr":[],"logo":"https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6InZpbmNpIiwiZWRpdHMiOnsicmVzaXplIjp7IndpZHRoIjo4NSwiaGVpZ2h0Ijo4NSwiZml0IjoiY292ZXIifX0sImZpbGVIYXNoIjoiOTEyMDc5ZmVhMjZiZTViNmQ2YTBiOTI1NzJlYWJiMGMifQ==?signature=efa11a6b62f11d98a1f129a16063f9a32b1d60cab08f60da1ce40247b2b60072","zone":"A","lots":[{"ty":"T1","na":"Appartement","s":22.0,"f":"4","ex":["E"],"ter":0,"pk":0,"pr":[{"tva":20.0,"p":155000.0}],"opt":false},{"ty":"T1","na":"Appartement","s":31.0,"f":"RDC","ex":["E"],"ter":14.3,"pk":0,"pr":[{"tva":20.0,"p":205000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":44.0,"f":"3","ex":[],"ter":7.6,"pk":0,"pr":[{"tva":20.0,"p":275000.0}],"opt":false},{"ty":"T2","na":"Appartem