ipale ou d’investissement locatif en VEFA dans le Golfe du Morbihan.","addr":"1 rue du Tourbillon","gal":["https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6Ijg5MzM0ZTU1MThmYTI3ZDQ5MTJkMjE3YWZlOTdlYzkzNTgwY2Q2MmQiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiIwMjJiMDFmMWNjNmFjNjdiNDUwMGI5ZDlmNTM3MGRhZSJ9?signature=91ba32d8f6076b8f8671576a49548527e62b8421846b06d9cfea7df9e9c5b164","https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImFjN2QzNWMzZmUxNTExMGJhYjc4OGUwYWY0NTk2ZWUwZGMxY2U2MzYiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiI2MmNhYzFlYzI4NDI1ZDRhZTliNzA0MmYyZTRjMDViYSJ9?signature=6fb9554de461cc4e7031eb0815c1e453f03e5d1036744bb06cf6d5e4e0ecac71"],"yt":[],"vr":[],"logo":"https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImNyZWRpdGFncmljb2xlIiwiZWRpdHMiOnsicmVzaXplIjp7IndpZHRoIjo4NSwiaGVpZ2h0Ijo4NSwiZml0IjoiY292ZXIifX0sImZpbGVIYXNoIjoiZTg0YTg3OGVlYzkxMjFhYmU2MTI5ZWU1ZmViZDJiYTcifQ==?signature=10d64a5a8a03a0cfd1369bd886ed2be380b7f0713b56542502ecbcd114d578d8","zone":"B1","lots":[{"ty":"T3","na":"Appartement","s":67.49,"f":"RDC","ex":[],"ter":7.2,"pk":1,"pr":[{"tva":20.0,"p":288000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":67.49,"f":"1","ex":[],"ter":6.93,"pk":1,"pr":[{"tva":20.0,"p":299000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":69.62,"f":"1","ex":[],"ter":6.93,"pk":1,"pr":[{"tva":20.0,"p":307000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":67.59,"f":"RDC","ex":[],"ter":7.2,"pk":1,"pr":[{"tva":20.0,"p":308000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":70.33,"f":"1","ex":[],"ter":6.93,"pk":1,"pr":[{"tva":20.0,"p":313000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":70.33,"f":"1","ex":[],"ter":6.93,"pk":1,"pr":[{"tva":20.0,"p":316000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":70.33,"f":"RDC","