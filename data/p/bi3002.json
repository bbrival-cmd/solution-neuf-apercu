0 minutes et aéroport Montpellier-Méditerranée à 25 minutes ;\n\n• Voie verte à 800 mètres pour déplacements doux et liaisons locales.","addr":"7 Chemin Des Vignes","gal":["https://www.valorissimo.com/logos/programDocuments/public-c651a3f3-31d6-409f-aec2-e6640462fae9.jpg","https://www.valorissimo.com/logos/programDocuments/public-f1fd0585-bf3c-4e1a-8737-4152af7545d7.jpg","https://www.valorissimo.com/logos/programDocuments/public-69c47c2a-48d8-4b1a-9c69-7a42b73aefc0.jpg","https://www.valorissimo.com/logos/programDocuments/public-15bc158b-5aff-4369-a0a3-931ab83cca77.jpg","https://www.valorissimo.com/logos/programDocuments/public-41341abe-6b55-4e51-9502-9462906ca925.jpg","https://www.valorissimo.com/logos/programDocuments/public-f4cae953-30f2-4f12-960b-31465983621a.jpg","https://www.valorissimo.com/logos/programDocuments/public-be782274-e0d9-4788-ab55-21b9ad97e376.jpg"],"yt":[],"vr":["https://www.visiolab.fr/MaquetteOrbitale/Bouygues/BalarucLesBains/LesSalines/"],"logo":null,"zone":"B1","lots":[{"ty":"T2","na":"Appartement","s":43.59,"f":"2","ex":["E"],"ter":10.58,"jd":0,"pk":2,"pr":[{"tva":20.0,"p":187000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":43.78,"f":"2","ex":["W"],"ter":10.15,"jd":0,"pk":2,"pr":[{"tva":20.0,"p":189000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":45.0,"f":"2","ex":["W"],"ter":13.07,"jd":0,"pk":2,"pr":[{"tva":20.0,"p":199000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":47.42,"f":"2","ex":["N"],"ter":11.51,"jd":0,"pk":2,"pr":[{"tva":20.0,"p":201000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":66.56,"f":"1","ex":["E"],"ter":10.57,"jd":0,"pk":2,"pr":[{"tva":20.0,"p":234000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":66.48,"f":"2","ex":["S"],"ter":10.23,"jd":0,"pk":2,"pr":[{"tva":20.0,"p":239000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":61.19,"f":"2","ex":["E"],"ter":10.23,"jd":0,"pk":2,"pr":[{"tva":20.0,"p":254000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":65.22,"f":"1","ex":["E"],"ter":11.84,"jd":0