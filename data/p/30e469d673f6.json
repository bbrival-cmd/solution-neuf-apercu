eu où bâtir vos souvenirs, BOSCAÏA vous ouvre les portes d’un avenir serein, au cœur d’un quartier où il fait bon vivre et évoluer.","addr":"4 avenue du Mascaret","gal":["https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6IjM3MGFhMDkzNDY5N2U2MTliNzBkMGMzMmYyNDg0NmMzMjZhMzljODUiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiJlNjhkMDc1YjQ2OTJiNTAyZjI2MzMyMzdlODljY2VhZSJ9?signature=ff50e8d33064622363da141638363a56a01b7c4c9605022fd15f82edf34cae3d","https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6IjYwMzI3MjZlZTg2YzMxMGZkMmE1MmI5ZDIyMGUwYWM2NjYwMmZkYjMiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiJkOTNjOGJjOTUwOWM0YjAzZGVlMTAxY2YxNjQwOGIzNSJ9?signature=89f9c9c302ded2fb117a41e26aaaa4f1a188cf0b990af04ff82befee9e93b992"],"yt":["https://youtu.be/wn4_DSl3h5Y"],"vr":["https://app.threed.fr/88747e64-bed1-4038-b00b-2740b18aebaf/maquette%20a%C3%A9rienne%20g%C3%A9n%C3%A9rale"],"logo":"https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6InF1YXJ0dXMiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjg1LCJoZWlnaHQiOjg1LCJmaXQiOiJjb3ZlciJ9fSwiZmlsZUhhc2giOiIyODJkMTQ1YjZiMjVkZTUzZGNmNTk2Mzc1ZTIwOWI0MiJ9?signature=7dde1c9b908e2d55f4a358e355c8fa6f29608d195a6b2b3051b8ecc45cd33c34","zone":"B1","lots":[{"ty":"T2","na":"Appartement","s":38.96,"f":"2","ex":["N"],"ter":11.22,"pk":2,"pr":[{"tva":20.0,"p":183000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":39.84,"f":"2","ex":["S"],"ter":11.22,"pk":2,"pr":[{"tva":20.0,"p":184000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":41.28,"f":"1","ex":["N"],"ter":11.22,"pk":2,"pr":[{"tva":20.0,"p":184000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":38.09,"f":"7","ex":["S"],"ter":7.34,"pk":2,"pr":[{"tva":20.0,"p":184000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":45.46,"f":"1","ex":["N"],"ter":11.22,"pk":2,"pr":[{"tva"