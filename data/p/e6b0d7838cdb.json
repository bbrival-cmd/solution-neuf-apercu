.\n\nPour obtenir les plans ou davantage d'informations sur les prestations proposées, contactez-nous. Notre équipe se tient à votre disposition pour vous accompagner dans votre projet immobilier.\n\nPERMANENCE SUR PLACE tout l'été le mercredi de 16 à 18 h","addr":"Rue d’Isaac","gal":["https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6IjFhZWQ4MWVlNDExMzQyNTY2YmU0N2Q5YjMwNWNjMzdlNmIzM2UyMTQiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiI3NGJmMmNhNjhlZDFhMmRhMThmMzE4Y2Q5OTEyNGRmMiJ9?signature=bfdb348002a9548ba087ef47182a135d099e07f81bdeafe659b151a09306f829","https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6IjE5Yjg0N2MxNGFkYWU5MTA5MDVhNGM2OGY4YzY0Nzk2N2JlZjliOTIiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiIxMDcwNWJlMjRmODNhOWUzMmUyNmQwZDk2ODAxNTI0NCJ9?signature=ec73e905e86c7f9a816add94e807e01f4dda1fd7e7661d516647bcfacb6a1ad8","https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6IjIxM2Q5MGU5MDQ0OTZjZTFlN2VmZTVlMDVlZjEyNzdlNmQ4YzgxMmIiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiI3OTRiZTZmMDNhMDA3MWMxNGRmZjk1MTlhMDYyOTA0MiJ9?signature=44ca7efc389a932f1f85bba58e06590a1487f78519747b0446d7f9c5da8e6534"],"yt":[],"vr":[],"logo":"https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImIwMDE1YTliYmI2Njg2ZTgzMjkwNGEyYjNkNDhlZDc1IiwiZWRpdHMiOnsicmVzaXplIjp7IndpZHRoIjo4NSwiaGVpZ2h0Ijo4NSwiZml0IjoiY292ZXIifX0sImZpbGVIYXNoIjoiYjAwMTVhOWJiYjY2ODZlODMyOTA0YTJiM2Q0OGVkNzUifQ==?signature=b5d46ada06f6f543767db5dd1021af7e4cca5b543276876ed2ff39e7095debbe","zone":"B1","lots":[{"ty":"T1","na":"Appartement","s":29.01,"f":"2","ex":["SO"],"ter":3.75,"pk":0,"pr":[{"tva":20.0,"p":132100.0}],"opt":false},{"ty":"T2","na":"Appartement","s":43.14,"f":"2","ex":["NE"],"ter":0,"pk":0