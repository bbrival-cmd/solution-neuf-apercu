ENCE offre un art de vivre méditerranéen rare, alliant sérénité et dynamisme.","addr":"Avenue du Général Raoul SALAN","gal":["https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImY5ZTQyZGU0Y2UxYjQ4MzJkMTIxOGE0MDlhMDU5NjhjZmExNzFmZTQiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiJhMTZhNTg0NWU3YWI3NDc5ZmY4NTQwMjVmMTUwY2YwMiJ9?signature=6b2891dbd796e8ce4d1076715d84bfaa4336bec35738e9b15e05291fd0091560","https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6IjFlMWE4ZjZmNjgyYjIyODdlMTg5MDJmNGM0ZDVlYWUzZWFjYTQzNzAiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiIyOWQ2Mzk4OThlNWZiMjMwM2E4OTZiMjIyNDAwNjJjMCJ9?signature=6716db3dc93a9b1477d5278d946749bce3e78a2d6f133a00c241d50342d5d2d9","https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImY0NGFlYzdkMDE4M2ZkZTNiYjlhMTczZjUwMWE2NWFiNjU1MDdlMGQiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiI2ZTgyZGRmYzM5YjE1YTFhYWQ2MDlhNjU5NjYzNzZkMSJ9?signature=07843200aa4a3159b13057e714226afcf4fabc18dad4b0262a2cf14a06e4d00c"],"yt":[],"vr":[],"logo":"https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6InZpbmNpIiwiZWRpdHMiOnsicmVzaXplIjp7IndpZHRoIjo4NSwiaGVpZ2h0Ijo4NSwiZml0IjoiY292ZXIifX0sImZpbGVIYXNoIjoiOTEyMDc5ZmVhMjZiZTViNmQ2YTBiOTI1NzJlYWJiMGMifQ==?signature=efa11a6b62f11d98a1f129a16063f9a32b1d60cab08f60da1ce40247b2b60072","zone":"A","lots":[{"ty":"T1","na":"Appartement","s":31.0,"f":"RDC","ex":["S"],"ter":0,"pk":1,"pr":[{"tva":20.0,"p":165000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":37.0,"f":"RDC","ex":["SE"],"ter":18.2,"pk":1,"pr":[{"tva":20.0,"p":195000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":38.0,"f":"1","ex":["SE"],"ter":13.75,"pk":1,"pr":[{"tva":20.0,"p":215000.0}],"opt":false},{"ty":"T2","na":"Apparteme