PTZ).\n\n*Voir conditions sur www.legendre-immobilier.com/offres-commerciales\n(Ref.02981/522476)","addr":" ","gal":["https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6IjFlN2Q4Mzc0ZjI2NTlmOTdiNTgwOGEwZmJmNDBiMTg4YjcxOWMxZDciLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiJhYTY5NGYxMWNlODlmOGU4MGNlZTdkNjRkYTY3Nzg1NSJ9?signature=31b723e37fcf7ffee2785c2438abe1f47e1bb3065d1f129afe4c7fca3dcb84b5","https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImIwYzFkODMwMDNkYzZhMDBiOTIzMzlmNTk4MDY2ZGI4NWEwZjhmMjYiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiIwNjFhM2JlMzNkOTk2NmE2MWQxZTZmNjAzOGViNWJlNSJ9?signature=ad620dac321736710cce832536ad17cc5a4594a62b8ba5b1e4a1ddd4d314a0ed"],"yt":[],"vr":[],"logo":"https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6InVwbG9hZGluZ182YTEwNTk1MjVlMGJhOC40NjU4NDE0NSIsImVkaXRzIjp7InJlc2l6ZSI6eyJ3aWR0aCI6ODUsImhlaWdodCI6ODUsImZpdCI6ImNvdmVyIn19LCJmaWxlSGFzaCI6IjRmZmE1Y2JjOGY4NTk4NmM2YzI1ODBlNDg5NGJhZGZhOThlMzdlMDFlNDRhNTA2ZDUxNjFiNWRiYjU4OTMwNDkifQ==?signature=405bc10a86ddaa9270d65ed00e029772d9a71204a3a1881607b7f98695fd26a3","zone":"A","lots":[{"ty":"T2","na":"Appartement","s":48.68,"f":"3","ex":["NO"],"ter":0,"pk":1,"pr":[{"tva":20.0,"p":254000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":52.86,"f":"1","ex":["S"],"ter":0,"pk":1,"pr":[{"tva":20.0,"p":275000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":52.18,"f":"2","ex":["S"],"ter":0,"pk":1,"pr":[{"tva":20.0,"p":280000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":54.25,"f":"1","ex":["SO"],"ter":0,"pk":1,"pr":[{"tva":20.0,"p":285000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":54.25,"f":"2","ex":["SO"],"ter":0,"pk":1,"pr":[{"tva":20.0,"p":290000.0}],"opt":false},{"ty":"T3","na":"Appartement","s":54.07,"f":"2","ex":[],"ter":0,"pk":1,"pr":[{"tva":20.0,"p"