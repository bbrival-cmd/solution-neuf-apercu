ée avec des assises et un potager Locaux vélos spacieux munis de dispositifs d’accroche Chapes flottantes sur résiliant acoustique Cloisons de 7 cm avec laine de verre Vidéophone connecté avec commande à distance Portes palières certifiées classement A2P1*","addr":"RUE OLYMPE DE GOUGES 94140 ALFORTVILLE","gal":[],"yt":[],"vr":["https://lfp-maquette.fr/alfortville/#/"],"logo":"https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImNhdGVsbGEiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjg1LCJoZWlnaHQiOjg1LCJmaXQiOiJjb3ZlciJ9fSwiZmlsZUhhc2giOiIzMTUxNDQwZmQwZDUwYzVlNTNlNTNiNDQ4MTIwYWM5MSJ9?signature=0e2a9840ec2bcb1cb857e64cfdf742d91b864b44631c5ea500797fe35f745d4a","zone":"A","lots":[{"ty":"studio","na":"Appartement","s":31.42,"f":"2","ex":[],"ter":0,"pk":0,"pr":[{"tva":20.0,"p":229763.0}],"opt":false},{"ty":"studio","na":"Appartement","s":31.42,"f":"4","ex":[],"ter":0,"pk":0,"pr":[{"tva":20.0,"p":233175.0}],"opt":false},{"ty":"studio","na":"Appartement","s":31.42,"f":"5","ex":[],"ter":0,"pk":0,"pr":[{"tva":20.0,"p":233175.0}],"opt":false},{"ty":"studio","na":"Appartement","s":31.42,"f":"5","ex":[],"ter":0,"pk":0,"pr":[{"tva":20.0,"p":234313.0}],"opt":false},{"ty":"T2","na":"Appartement","s":44.64,"f":"4","ex":[],"ter":5.0,"pk":0,"pr":[{"tva":20.0,"p":262749.0},{"tva":5.5,"p":231000.0}],"opt":true},{"ty":"T2","na":"Appartement","s":45.91,"f":"2","ex":[],"ter":6.0,"pk":0,"pr":[{"tva":20.0,"p":267299.0},{"tva":5.5,"p":235000.0}],"opt":true},{"ty":"T2","na":"Appartement","s":44.64,"f":"2","ex":[],"ter":5.0,"pk":1,"pr":[{"tva":20.0,"p":276398.0},{"tva":5.5,"p":243000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":44.64,"f":"3","ex":[],"ter":5.0,"pk":1,"pr":[{"tva":20.0,"p":277536.0},{"tva":5.5,"p":244000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":48.95,"f":"4","ex":[],"ter":7.0,"pk":1,"pr":[{"tva":20.0,"p":279811.0},{"tva":5.5,"p":246000.0}],"opt":true},{"ty":"T2","na":"Appartement","s":46.23,"f":"2","ex":[],"ter":6.0,"pk":1,"pr":[