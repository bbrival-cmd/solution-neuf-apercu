ée de la métropole toulonnaise.\nContactez dès maintenant nos conseillers pour découvrir les logements disponibles et concrétiser votre projet immobilier.","addr":"408 Avenue Jean Monnet","gal":["https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6IjdiMTUwMTlkMTFiODQ2NDkwZGFkNzFkODhkMzZmNzQ5NTkxMzM3MGQiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiI3YjA2MDhiYTU4ZDUwYWY0ODQzZmVmYmYwOGExZTM2YiJ9?signature=feeec36bf7385f98442547814a36cef80ce64b09205e6d43a98183b2c5cd2603"],"yt":[],"vr":[],"logo":"https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6InZpbmNpIiwiZWRpdHMiOnsicmVzaXplIjp7IndpZHRoIjo4NSwiaGVpZ2h0Ijo4NSwiZml0IjoiY292ZXIifX0sImZpbGVIYXNoIjoiOTEyMDc5ZmVhMjZiZTViNmQ2YTBiOTI1NzJlYWJiMGMifQ==?signature=efa11a6b62f11d98a1f129a16063f9a32b1d60cab08f60da1ce40247b2b60072","zone":"A","lots":[{"ty":"T2","na":"Appartement","s":44.0,"f":"RDC","ex":["N"],"ter":8.95,"pk":1,"pr":[{"tva":10.0,"p":201666.66},{"tva":20.0,"p":220000.0}],"opt":true},{"ty":"T2","na":"Appartement","s":48.0,"f":"RDC","ex":["N"],"ter":6.28,"pk":1,"pr":[{"tva":10.0,"p":220000.0},{"tva":20.0,"p":240000.0}],"opt":true},{"ty":"T2","na":"Appartement","s":47.0,"f":"2","ex":["N"],"ter":12.78,"pk":1,"pr":[{"tva":10.0,"p":233750.0},{"tva":20.0,"p":255000.0}],"opt":true},{"ty":"T2","na":"Appartement","s":44.0,"f":"RDC","ex":["S"],"ter":7.37,"pk":1,"pr":[{"tva":10.0,"p":242916.66},{"tva":20.0,"p":265000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":45.0,"f":"RDC","ex":["S"],"ter":7.25,"pk":1,"pr":[{"tva":10.0,"p":242916.66},{"tva":20.0,"p":265000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":44.0,"f":"RDC","ex":["SO"],"ter":7.86,"pk":1,"pr":[{"tva":10.0,"p":242916.66},{"tva":20.0,"p":265000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":45.0,"f":"RDC","ex":["SO"],"ter":8.18,"pk":1,"pr":[{"tva":10.0,"p":242916.66},{"tva":20.0,"p":265000.0}],"opt":true},{"ty":"T2","na":