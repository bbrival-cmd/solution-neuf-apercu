 d'aménagements paysagers soignés.","addr":"\n\nANGLE AVENUE COULET / AVENUE DE LA COTE D'ARGENT\n","gal":["https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImFiYzVjOTljNmJhNGY0ZmIzMTM0YzQxYmY3YmVkOGJhNzUwNzQzYWMiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiI5YTg3YTFmMTlhZDkyMjVkYzliZTA3MGQ0NzE0ZTJkMyJ9?signature=c6adf3ed7c80d8aa647faf4105a8495b7918bf7842ceec109962f493a03cf1f0","https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6ImYzYjM3YjZiOGU3OGY5ZWYzMTU1NjgwNGVjYzRlMDJkZDM4N2EyOWYiLCJlZGl0cyI6eyJyZXNpemUiOnsid2lkdGgiOjkwMCwiaGVpZ2h0Ijo5MDAsImZpdCI6Imluc2lkZSJ9fSwiZmlsZUhhc2giOiI2ODhlNTBlMWUyMzAyM2ZiMTBhNWQyZGViZmFmY2ZjZiJ9?signature=917c6928abb361a6a6da3151df4fc9e7e394069e5719e2c9d13105324b5f3384"],"yt":[],"vr":[],"logo":"https://dj32ymiemc11o.cloudfront.net/eyJidWNrZXQiOiJvdGFyZWUtcHJvZHVjdGlvbi1maWxlcyIsImtleSI6Imxlc25vdXZlYXV4Y29uc3RydWN0ZXVycyIsImVkaXRzIjp7InJlc2l6ZSI6eyJ3aWR0aCI6ODUsImhlaWdodCI6ODUsImZpdCI6ImNvdmVyIn19LCJmaWxlSGFzaCI6ImUxMDc4NzA5MzI5MTI5ZmY1MjUzZTNmN2YwYzZlZTI4In0=?signature=b6c508b23a86881a6469899d4822eff939ed4a0d1409af703ed11b39eb4e16b7","zone":"A","lots":[{"ty":"T1","na":"Appartement","s":24.66,"f":"2","ex":["N"],"ter":0,"pk":0,"pr":[{"tva":20.0,"p":138000.0}],"opt":false},{"ty":"T1","na":"Appartement","s":25.01,"f":"1","ex":["N"],"ter":0,"pk":0,"pr":[{"tva":20.0,"p":140000.0}],"opt":false},{"ty":"T1","na":"Appartement","s":25.01,"f":"2","ex":["N"],"ter":0,"pk":0,"pr":[{"tva":20.0,"p":143000.0}],"opt":false},{"ty":"T1","na":"Appartement","s":24.8,"f":"2","ex":["N"],"ter":0,"pk":0,"pr":[{"tva":20.0,"p":143000.0}],"opt":false},{"ty":"T1","na":"Appartement","s":25.03,"f":"2","ex":["N"],"ter":0,"pk":0,"pr":[{"tva":20.0,"p":146000.0}],"opt":false},{"ty":"T2","na":"Appartement","s":42.8,"f":"1","ex":["N"],"ter":0,"pk":2,"pr":[{"tva":20.0,"p":217900.0}],"opt":false},{"ty":"T2","na":"Appartement","s":41.55,"f"